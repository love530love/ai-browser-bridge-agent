{
  "manifest_version": 3,
  "name": "Browser Agent Bridge",
  "version": "0.1.0",
  "description": "Developer-mode bridge for agent-controlled browser inspection and automation.",
  "permissions": ["tabs", "activeTab", "scripting", "debugger", "storage", "downloads", "cookies", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Browser Agent Bridge" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
